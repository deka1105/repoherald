# Clerk publishable key for the instance this build should talk to.
#
# Public by design — it identifies the Clerk frontend API and ships inside the
# binary. The secret key is server-side only and must never appear here.
#
# EXPO_PUBLIC_* values are inlined at BUILD time, so this has to be present when
# the bundle is made, not when the app runs. Builds read it from the EAS
# environment named by the build profile's "environment" in eas.json:
#
#   eas env:create --environment production  --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_live_...
#   eas env:create --environment preview     --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_test_...
#   eas env:create --environment development --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_test_...
#
# A production build MUST use the pk_live_ key from Clerk's production instance.
# A pk_test_ key in a shipped app points it at the development instance, whose
# OAuth connections use Clerk's shared credentials and are not meant for
# end users.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
